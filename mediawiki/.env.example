# ═══════════════════════════════════════════════════════════════════════════
# papaia-addon-mediawiki — environment variables
# by Fidonis GmbH · https://fidonis.de
#
# Seeded by `papaia-ctl addon install mediawiki` into the config bundle at
# <papaia-config>/addons/mediawiki/.env. Copied into this directory by
# `papaia-ctl addon start mediawiki` before docker compose up.
# GENERATE_* values are auto-generated as random secrets on first install.
# CHANGE_ME values must be set before starting the add-on.
# REPLACE_WITH_* values are copied from Keycloak after the client import.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core OIDC ────────────────────────────────────────────────────────────
# Keycloak issuer URL — browser-facing, used for the wiki login. Must match
# OIDC_ISSUER of the core.
OIDC_ISSUER=CHANGE_ME

# papAIa config directory — used to mount the local CA cert so containers
# can verify TLS connections to the bundled Keycloak. Auto-filled from the
# core config on 'papaia-ctl addon install mediawiki'.
PAPAIA_CONFIG_DIR=CHANGE_ME

# Claim carrying the user's groups in the wiki's own login token. The
# bundled Keycloak client puts the realm roles there
# (see integration/infra/keycloak/mediawiki.json).
OIDC_GROUPS_CLAIM=groups

# ── Wiki — site ───────────────────────────────────────────────────────────
# Browser-facing URL of the wiki (scheme + host + optional port, no trailing
# slash). Every link, the OIDC redirect URI and the MCP server's public URL
# (<MW_SERVER>/mcp) are built from it, so the browser AND LibreChat must
# reach it. The published port (MEDIAWIKI_EXT_PORT) speaks https with a
# certificate from the papaia local CA, so the default works for a
# single-host setup with the bundled Keycloak (same host name as AUTH_HOST).
# Behind a reverse proxy with its own certificate: https://wiki.example.com
MW_SERVER=https://host.docker.internal:8020
MW_SITE_NAME=Wiki
# Content language (ISO 639 code, e.g. en, de).
MW_LANG=en
MW_TIMEZONE=Europe/Berlin

# ── Wiki — secrets ────────────────────────────────────────────────────────
# $wgSecretKey and $wgUpgradeKey. Rotating MW_SECRET_KEY logs everyone out.
MW_SECRET_KEY=GENERATE_SECRET
MW_UPGRADE_KEY=GENERATE_SECRET

# ── Wiki — database ───────────────────────────────────────────────────────
MW_DB_NAME=mediawiki
MW_DB_USER=mediawiki
MW_DB_PASSWORD=GENERATE_SECRET

# ── Wiki — break-glass admin ──────────────────────────────────────────────
# Local account, created on first start and re-synced on every start (the
# password below is authoritative). Not usable in the browser while local
# login is off -- see README, "Break-glass admin".
MW_ADMIN_USER=Admin
MW_ADMIN_PASSWORD=GENERATE_SECRET

# true = show the local password form and stop redirecting to Keycloak.
# Break-glass only; set back to false afterwards.
MW_ENABLE_LOCAL_LOGIN=false

# true = send users straight to Keycloak instead of showing a login button.
MW_AUTO_LOGIN=true

# Label of the login button (shown when MW_AUTO_LOGIN=false).
MW_LOGIN_BUTTON_LABEL=Log in with Keycloak

# Link an existing wiki account to a Keycloak login by e-mail address.
# Leave false unless every e-mail address in Keycloak is verified.
MW_OIDC_MIGRATE_BY_EMAIL=false

# ── Wiki — access tiers ───────────────────────────────────────────────────
# Restricted namespaces, Name:id — ids even and >= 3000; each gets a talk
# namespace at id+1. Leave empty for a wiki without tiers.
MW_NAMESPACES=Internal:3000,Management:3002,Operations:3004

# Who may read and edit each namespace: Name=group,group;Name=group...
# Group names are values of the groups claim; each becomes a wiki group of
# the same name, synced on every login. Users in none of them read and edit
# the main namespace only.
MW_NAMESPACE_READ_GROUPS=Internal=internal,management,papaia-admin;Management=management,papaia-admin;Operations=papaia-admin

# Members of these groups become wiki sysop + bureaucrat + interface-admin.
# They can read EVERY tier: a bureaucrat can add themselves to any tier group
# (Special:UserRights), and an interface-admin can run site-wide JavaScript.
# Grant this only to groups that may see everything (README, "Administrators").
MW_SYSOP_GROUPS=papaia-admin

# ── Wiki — mail ───────────────────────────────────────────────────────────
# SMTP relay as host:port, used without authentication. Empty = mail off.
MW_SMTP_HOST=
MW_EMAIL_FROM=wiki@localhost

# ── Wiki — uploads ────────────────────────────────────────────────────────
# Files follow the tiers through their name: File:Management:Plan.pdf is in
# the Management tier. A file without a tier prefix is readable by every
# logged-in user, wherever it is embedded (README, "Files").
MW_ENABLE_UPLOADS=true
MW_FILE_EXTENSIONS=png,gif,jpg,jpeg,webp,pdf
# Capped at 100 by the image's PHP limits.
MW_MAX_UPLOAD_MB=50

# Directory with extra *.php settings loaded after the add-on's own.
# MW_SETTINGS_DIR=./settings.d

# ── Wiki — external port ──────────────────────────────────────────────────
# Host port of the wiki; it speaks https. Must match the port in MW_SERVER
# when the wiki is reached directly.
MEDIAWIKI_EXT_PORT=8020

# Show PHP exception details in the browser. Troubleshooting only.
MW_DEBUG=false

# ── Keycloak OIDC client ──────────────────────────────────────────────────
# Client ID of the wiki login; the bundled client export uses "mediawiki".
MW_OIDC_CLIENT_ID=mediawiki

# mediawiki: client secret for the wiki login. Copy from Keycloak Admin UI →
# Clients → mediawiki → Credentials → Client Secret after the import.
KC_MEDIAWIKI_CLIENT_SECRET=REPLACE_WITH_KC_MEDIAWIKI_CLIENT_SECRET

# ── MCP server ────────────────────────────────────────────────────────────
# Public URL of the MCP endpoint. Empty = <MW_SERVER>/mcp, which is where
# the wiki serves it; set it only when the MCP server is published elsewhere.
# The browser sign-in and LibreChat both use it, so both must reach it, and
# it must be https unless the host is localhost (which LibreChat in a
# container cannot reach).
MEDIAWIKI_MCP_PUBLIC_URL=

# What the MCP server may do as the signed-in user, as OAuth grants. Each
# user consents to this list once; changing it asks every user to consent
# again. Moving is off by default (a move out of a tier publishes the page):
# add movepage to allow it, delete and protect to allow deleting and
# protecting pages, highvolume for higher API limits. The user's own rights
# still apply.
MEDIAWIKI_MCP_GRANTS=basic,editpage,createeditmovepage,uploadfile,uploadeditmovefile

# Signs the tokens the MCP server issues and encrypts its session store.
# Rotating it signs every user out of their MCP connections.
MEDIAWIKI_MCP_SIGNING_KEY=GENERATE_SECRET

# OAuth callbacks of the MCP clients that may sign in, comma-separated, in
# addition to loopback addresses (http://localhost:<any port>/...) and a few
# vendor clients the server trusts by default. LibreChat's is
# <DOMAIN_SERVER>/api/mcp/MediaWiki/oauth/callback, with DOMAIN_SERVER from
# the core's LibreChat configuration (default http://host.docker.internal:8000).
MEDIAWIKI_MCP_ALLOWED_REDIRECTS=http://host.docker.internal:8000/api/mcp/MediaWiki/oauth/callback

# Browser origins allowed to call the MCP endpoint directly; empty refuses
# browser requests. LibreChat calls it server-side and needs no entry.
MEDIAWIKI_MCP_ALLOWED_ORIGINS=

# One of: debug, info, warning, error
MEDIAWIKI_MCP_LOG_LEVEL=info

# ── Images (pin specific versions for reproducible deployments) ───────────
# MEDIAWIKI_IMAGE=ghcr.io/fidonis/papaia-mediawiki:1.43.11-1.0.0
# MEDIAWIKI_DB_IMAGE=docker.io/library/mariadb:11.8.9
# MEDIAWIKI_MCP_IMAGE=ghcr.io/professionalwiki/mediawiki-mcp-server:0.19.0
