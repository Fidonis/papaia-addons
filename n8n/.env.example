# ═══════════════════════════════════════════════════════════════════════════
# papaia-addon-n8n — environment variables
# by Fidonis GmbH · https://fidonis.de
#
# Seeded by `papaia-ctl addon install n8n` into the config bundle at
# <papaia-config>/addons/n8n/.env. Copied into this directory by
# `papaia-ctl addon start n8n` before docker compose up.
# GENERATE_* values are auto-generated as random secrets on first install.
# CHANGE_ME values must be set manually before starting the addon.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core OIDC ────────────────────────────────────────────────────────────
# Keycloak issuer URL — browser-facing, used for iss-claim validation.
# Must match OIDC_ISSUER from the core setup.
OIDC_ISSUER=CHANGE_ME

# Split OIDC endpoints. The login URL is opened in the user's browser and
# must be reachable from there; token and JWKS calls are server-side and
# stay on internal Docker DNS. Auto-filled from the core config, as are the
# scopes.
OIDC_AUTH_URL=CHANGE_ME
OIDC_TOKEN_URL=CHANGE_ME
OIDC_JWKS_URL=CHANGE_ME
OIDC_SCOPES=CHANGE_ME

# papAIa config directory — used to mount the local CA cert so the SSO gate
# can verify TLS connections to the bundled Keycloak. Auto-filled from the
# core config on 'papaia-ctl addon install n8n'.
PAPAIA_CONFIG_DIR=CHANGE_ME

# ── n8n — Public URL ──────────────────────────────────────────────────────
# Browser-facing URL of n8n (scheme + host + optional port, no trailing
# slash — the gate's callback and logout URLs append their own path). Must
# match the redirect URI registered in the Keycloak 'n8n' client. n8n
# builds every webhook and OAuth callback URL from this value.
N8N_PUBLIC_URL=CHANGE_ME

# Hostname only (no scheme, no port) — n8n wants these separately.
N8N_HOSTNAME=CHANGE_ME
# Scheme of N8N_PUBLIC_URL. Only n8n's fallback base URL uses it: webhook and
# editor URLs come from N8N_PUBLIC_URL, and the engine listens on plain HTTP
# behind the gate either way. A literal rather than CHANGE_ME so that every
# install path (interactive, -y, the manager) lands on the same value.
N8N_PROTOCOL=http

# Proxy hops in X-Forwarded-For between the browser and n8n. Two with the
# bundled chain (n8n-auth → n8n-proxy); raise it by one per additional
# reverse proxy in front, e.g. the Nginx Proxy Manager.
N8N_PROXY_HOPS=2

# ── n8n — Database ────────────────────────────────────────────────────────
N8N_DB=n8n
N8N_DBUSER=n8n
N8N_DBPASS=GENERATE_SECRET

# ── n8n — Credential encryption ───────────────────────────────────────────
# Encrypts stored workflow credentials. n8n would otherwise generate one
# into its data volume on first start, which makes restoring a backup onto a
# fresh volume useless — the restored credentials cannot be decrypted with a
# newly generated key. Keep this value with the backup, and never rotate it
# while credentials exist.
N8N_ENCRYPTION_KEY=GENERATE_SECRET

# ── Keycloak OIDC client secret ───────────────────────────────────────────
# Keycloak clients are imported from JSON — copy the secret from
# Keycloak Admin UI → Clients → n8n → Credentials → Client Secret.
KC_N8N_CLIENT_SECRET=REPLACE_WITH_KC_N8N_CLIENT_SECRET
N8N_OIDC_CLIENT_ID=n8n

# ── SSO gate — session cookie ─────────────────────────────────────────────
# Signs the oauth2-proxy session cookie.
# Generate with: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
N8N_COOKIE_SECRET=GENERATE_NEW_KEY_32BYTES_BASE64

# Marks the session cookie as Secure. Required behind HTTPS — browsers
# ignore Secure cookies over plain HTTP. Set to true when N8N_PUBLIC_URL
# uses an https:// scheme, false otherwise. Auto-filled from the core's
# OAUTH2_PROXY_COOKIE_SECURE.
N8N_COOKIE_SECURE=CHANGE_ME

# ── n8n — External port ───────────────────────────────────────────────────
# Host port of the SSO gate. This is the only published port of the add-on;
# the engine itself is never bound to the host.
N8N_EXT_PORT=8400

# ── n8n — Behaviour ───────────────────────────────────────────────────────
# Timezone for cron triggers and workflow timestamps.
TIMEZONE=Europe/Berlin

# n8n's telemetry ping. Off by default — a self-hosted deployment should not
# phone home unasked.
N8N_DIAGNOSTICS_ENABLED=false

# One of: error, warn, info, verbose, debug, silent
N8N_LOG_LEVEL=info

# ── Logout shim — configuration override ──────────────────────────────────
# Path to the nginx config for the logout shim. Defaults to the nginx.conf
# shipped next to the compose file; point it elsewhere to customise without
# editing the add-on. The file is mounted as an envsubst template: only
# N8N_LOGOUT_* placeholders are substituted, everything else is used as is.
# N8N_PROXY_CONF=./nginx.conf

# ── Images (pin specific versions for reproducible deployments) ───────────
# N8N_IMAGE=docker.io/n8nio/n8n:2.36.6
# N8N_DB_IMAGE=docker.io/library/postgres:18
# N8N_PROXY_IMAGE=docker.io/library/nginx:1.31-alpine
# N8N_OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.15.3
