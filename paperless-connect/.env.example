# ═══════════════════════════════════════════════════════════════════════════
# papaia-addon-paperless-connect — environment variables
# by Fidonis GmbH · https://fidonis.de
#
# Seeded by `papaia-ctl addon install paperless-connect` into the config
# bundle at <papaia-config>/addons/paperless-connect/.env. Copied into this
# directory by `papaia-ctl addon start paperless-connect` before docker
# compose up.
# CHANGE_ME values must be set manually before starting the addon.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core OIDC ────────────────────────────────────────────────────────────
# Keycloak issuer URL — browser-facing URL, used for OIDC token validation.
# Must match AUTH_HOST / OIDC_ISSUER from the core setup.
OIDC_ISSUER=CHANGE_ME

# papAIa config directory — used to mount the local CA cert so the MCP
# server can verify TLS connections to the bundled Keycloak.
# Auto-filled from the core config on 'papaia-ctl addon install paperless-connect'.
PAPAIA_CONFIG_DIR=CHANGE_ME

# ── MCP server ────────────────────────────────────────────────────────────
# Token audience expected in incoming Bearer tokens from LibreChat.
# REQUIRED, not cosmetic: this value only takes effect if a matching
# 'mcp-paperless-audience' mapper exists on the LibreChat Keycloak client.
# Without that mapper the tokens carry no 'aud' claim at all — see README
# step 2. mcp-paperless needs no client secret: it is a Bearer-token resource
# server that verifies tokens against Keycloak's public JWKS and never
# authenticates itself to Keycloak.
PAPERLESS_MCP_OIDC_AUDIENCE=mcp-paperless
PAPERLESS_MCP_OIDC_JWKS_CACHE_TTL=3600
# URL of the existing Paperless instance, as reachable from the MCP container.
# Typically the public URL (https://docs.example.com) when Paperless runs on a
# different host or behind TLS. Use http://host.docker.internal:<port> when it
# runs on the same host as papaia. See README — when routing through a reverse
# proxy, that proxy must forward X-Papaia-Remote-User rather than strip it.
PAPERLESS_MCP_PAPERLESS_URL=CHANGE_ME
PAPERLESS_MCP_REMOTE_USER_HEADER=X-Papaia-Remote-User
PAPERLESS_MCP_USERNAME_CLAIM=preferred_username
PAPERLESS_MCP_HTTP_TIMEOUT=30
PAPERLESS_MCP_MAX_DOWNLOAD_BYTES=10485760
PAPERLESS_MCP_PORT=8000
PAPERLESS_MCP_PATH=/mcp
PAPERLESS_MCP_LOG_LEVEL=INFO

# ── Images (pin specific versions for reproducible deployments) ───────────
# PAPERLESS_MCP_IMAGE=ghcr.io/fidonis/paperless-mcp-rbac:0.1.0
