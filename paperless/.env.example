# ═══════════════════════════════════════════════════════════════════════════
# papaia-addon-paperless — environment variables
# by Fidonis GmbH · https://fidonis.de
#
# Seeded by `papaia-ctl addon install paperless` into the config bundle at
# <papaia-config>/addons/paperless/.env. Copied into this directory by
# `papaia-ctl addon start paperless` before docker compose up.
# GENERATE_* values are auto-generated as random secrets on first install.
# CHANGE_ME values must be set manually before starting the addon.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core OIDC ────────────────────────────────────────────────────────────
# Keycloak issuer URL — browser-facing URL, used for OIDC login and token
# validation. Must match AUTH_HOST / OIDC_ISSUER from the core setup.
OIDC_ISSUER=CHANGE_ME

# papAIa config directory — used to mount the local CA cert so containers
# can verify TLS connections to the bundled Keycloak. Auto-filled from the
# core config on 'papaia-ctl addon install paperless'.
PAPAIA_CONFIG_DIR=CHANGE_ME

# ── Paperless-ngx — Public URL ────────────────────────────────────────────
# Browser-facing URL of the Paperless web UI (scheme + host + optional port).
# Must match the redirect URI registered in the Keycloak 'paperless' client.
PAPERLESS_PUBLIC_URL=CHANGE_ME

# ── Paperless-ngx — Database ──────────────────────────────────────────────
PAPERLESS_DB=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=GENERATE_SECRET

# ── Paperless-ngx — Security ──────────────────────────────────────────────
# Django secret key — long, random, never shared.
PAPERLESS_SECRET_KEY=GENERATE_SECRET

# ── Paperless-ngx — Bootstrap admin ──────────────────────────────────────
# Created on first container start. Use as break-glass access only —
# native login is disabled by default (SSO-only via Keycloak).
PAPERLESS_ADMIN_USER=paperless-admin
PAPERLESS_ADMIN_PASSWORD=GENERATE_SECRET
PAPERLESS_ADMIN_MAIL=admin@localhost

# ── Keycloak OIDC client secrets ──────────────────────────────────────────
# paperless: OIDC client secret for Paperless-ngx web login.
# Keycloak clients are imported from JSON — copy the secret from
# Keycloak Admin UI → Clients → paperless → Credentials → Client Secret.
KC_PAPERLESS_CLIENT_SECRET=REPLACE_WITH_KC_PAPERLESS_CLIENT_SECRET

# mcp-paperless: OIDC client secret for the MCP resource server.
# Not used for direct login — mcp-paperless is a Bearer-token resource server.
# Copy from: Keycloak Admin UI → Clients → mcp-paperless → Credentials → Client Secret.
KC_MCP_PAPERLESS_CLIENT_SECRET=REPLACE_WITH_KC_MCP_PAPERLESS_CLIENT_SECRET

# ── Paperless-ngx — OCR ───────────────────────────────────────────────────
# Primary language for Tesseract OCR (ISO 639-2/T code).
PAPERLESS_OCR_LANGUAGE=deu
# Additional languages (space-separated). Container ships with eng, deu,
# ita, spa, fra. Uncomment to add more.
# PAPERLESS_OCR_LANGUAGES=

# ── Paperless-ngx — HTTP protocol ────────────────────────────────────────
# Set to "https" when PAPERLESS_PUBLIC_URL uses HTTPS, "http" otherwise.
PAPERLESS_HTTP_PROTOCOL=http

# ── Paperless-ngx — SSO / Login behaviour ─────────────────────────────────
# Disable native username/password login; SSO becomes the only way in.
# Set to "true" for SSO-only deployments. Emergency access remains possible
# via `docker exec ... python manage.py createsuperuser`.
PAPERLESS_DISABLE_REGULAR_LOGIN=false

# Redirect the login page directly to Keycloak instead of showing the form.
PAPERLESS_REDIRECT_LOGIN_TO_SSO=false

# Auto-create a Paperless account for any authenticated Keycloak user.
PAPERLESS_SOCIAL_AUTO_SIGNUP=true

# Sync Keycloak realm roles to Paperless groups on every login. Only groups
# that already exist in Paperless are matched — the sync never creates them.
# Create the groups (e.g. "admin") once in Paperless and grant them the
# permissions the corresponding Keycloak realm role should have.
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=true
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS_CLAIM=groups

# ── Paperless-ngx — Reverse proxy ─────────────────────────────────────────
# Only needed when Paperless is reached through a reverse proxy (e.g. the
# Nginx Proxy Manager). Paperless derives the client IP for login rate
# limiting from these; without them logins can fail with 403 Forbidden.
# The count is the number of proxy hops in X-Forwarded-For, which may differ
# from the number of listed IPs. Leave both commented out when unused —
# an empty value is not the same as an unset one and aborts startup.
# PAPERLESS_TRUSTED_PROXIES=
# PAPERLESS_ALLAUTH_TRUSTED_PROXY_COUNT=1

# ── Paperless-ngx — Document processing ───────────────────────────────────
# Set to 0 to disable Tika/Gotenberg. Office document (.docx, .xlsx, .eml)
# ingestion will not work without Tika.
PAPERLESS_TIKA_ENABLED=1

# Paperless-ngx 3.x accepts duplicate documents by default and flags them in
# the UI. Uncomment to restore the 2.x behaviour of rejecting them outright.
# PAPERLESS_CONSUMER_DELETE_DUPLICATES=true

# ── Paperless-ngx — Storage directories ───────────────────────────────────
# Host-side paths for the three Paperless bind mounts. Default to paths
# relative to this compose file. Set to absolute paths for NAS mounts.
# MEDIA_DIRECTORY=./data/media
# EXPORT_DIRECTORY=./data/export
# CONSUME_DIRECTORY=./data/consume

# ── Paperless-ngx — External port ─────────────────────────────────────────
PAPERLESS_EXT_PORT=8010

# ── MCP server ────────────────────────────────────────────────────────────
# Token audience expected in incoming Bearer tokens from LibreChat.
# Must match the 'mcp-paperless-audience' mapper on the LibreChat Keycloak client.
PAPERLESS_MCP_OIDC_AUDIENCE=mcp-paperless
PAPERLESS_MCP_OIDC_JWKS_CACHE_TTL=3600
# Internal URL of the Paperless webserver (same Docker network).
PAPERLESS_MCP_PAPERLESS_URL=http://paperless:8000
PAPERLESS_MCP_REMOTE_USER_HEADER=X-Papaia-Remote-User
PAPERLESS_MCP_USERNAME_CLAIM=preferred_username
PAPERLESS_MCP_HTTP_TIMEOUT=30
PAPERLESS_MCP_MAX_DOWNLOAD_BYTES=10485760
PAPERLESS_MCP_PORT=8000
PAPERLESS_MCP_PATH=/mcp
PAPERLESS_MCP_LOG_LEVEL=INFO

# ── Images (pin specific versions for reproducible deployments) ───────────
# PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:3.0.5
# PAPERLESS_REDIS_IMAGE=docker.io/valkey/valkey:9-alpine
# PAPERLESS_DB_IMAGE=docker.io/library/postgres:18
# PAPERLESS_GOTENBERG_IMAGE=docker.io/gotenberg/gotenberg:8.34
# PAPERLESS_TIKA_IMAGE=docker.io/apache/tika:3.2.3.0
# PAPERLESS_MCP_IMAGE=ghcr.io/fidonis/paperless-mcp-rbac:0.1.1
