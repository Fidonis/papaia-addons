# ═══════════════════════════════════════════════════════════════════════════
# papaia-addon-qdrant-connect — environment variables
# by Fidonis GmbH · https://fidonis.de
#
# Seeded by `papaia-ctl addon install qdrant-connect` into the config bundle
# at <papaia-config>/addons/qdrant-connect/.env. Copied into this directory
# by `papaia-ctl addon start qdrant-connect` before docker compose up.
# CHANGE_ME values must be set manually before starting the addon.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core OIDC ────────────────────────────────────────────────────────────
# Keycloak issuer URL — browser-facing URL, used for OIDC token validation.
# Must match AUTH_HOST / OIDC_ISSUER from the core setup.
OIDC_ISSUER=CHANGE_ME

# papAIa config directory — used to mount the local CA cert so the MCP
# server can verify TLS connections to the bundled Keycloak.
# Auto-filled from the core config on 'papaia-ctl addon install qdrant-connect'.
PAPAIA_CONFIG_DIR=CHANGE_ME

# ── MCP server — OIDC ─────────────────────────────────────────────────────
# Token audience expected in incoming Bearer tokens from LibreChat.
# REQUIRED, not cosmetic: this value only takes effect if a matching
# 'mcp-qdrant-audience' mapper exists on the LibreChat Keycloak client.
# Without that mapper the tokens carry no matching 'aud' claim and every MCP
# call fails with 401 — see README step 2. mcp-qdrant needs no client secret:
# it is a Bearer-token resource server that verifies tokens against
# Keycloak's public JWKS and never authenticates itself to Keycloak.
QDRANT_MCP_OIDC_AUDIENCE=mcp-qdrant
QDRANT_MCP_OIDC_JWKS_CACHE_TTL=3600

# ── MCP server — Qdrant connection ────────────────────────────────────────
# URL of the existing Qdrant instance, as reachable from the MCP container.
# Use http://host.docker.internal:6333 when it runs on the same host as
# papaia, or the public URL when it runs elsewhere.
QDRANT_MCP_QDRANT_URL=CHANGE_ME

# HS256 signing secret for the derived Qdrant JWTs. This add-on does not own
# the Qdrant instance, so the value cannot be generated here: it MUST be
# identical to that instance's service.api_key, which also requires
# service.jwt_rbac=true. See README — Prerequisites.
QDRANT_MCP_QDRANT_JWT_SECRET=CHANGE_ME

# Lifetime of the JWTs the MCP server derives per request.
QDRANT_MCP_QDRANT_JWT_TTL=3600

# ── MCP server — Embeddings ───────────────────────────────────────────────
# OpenAI-compatible embeddings endpoint used by search_collection_by_text.
# The base URL must already include the API prefix. Inside papaia, LiteLLM is
# reachable at http://litellm:4000/v1 through the generated Seam-1 network
# override; the embedding model itself is resolved per collection from
# QDRANT_MCP_EMBEDDING_META_COLLECTION.
QDRANT_MCP_EMBEDDING_API_URL=http://litellm:4000/v1

# API key for the embeddings endpoint. For LiteLLM this is LITELLM_MASTER_KEY
# from <papaia-config>/ai/litellm/.env. Set to an empty value for
# unauthenticated providers.
QDRANT_MCP_EMBEDDING_API_KEY=CHANGE_ME

# Qdrant collection holding the per-collection embedding model metadata,
# written at ingestion time. Auto-bootstrapped if missing.
QDRANT_MCP_EMBEDDING_META_COLLECTION=_collection_meta

# ── MCP server — RBAC ─────────────────────────────────────────────────────
# Break-glass admin role: members of this Keycloak realm role always receive
# a global Qdrant manage token and can therefore bootstrap the ACL collection.
# The role must exist in the realm and be assigned — see README step 2.
QDRANT_MCP_RBAC_ADMIN_ROLE=qdrant-admin

# Qdrant collection holding the role grants. Auto-created on first access.
QDRANT_MCP_RBAC_ACL_COLLECTION=_rbac_acl

# In-memory ACL cache TTL in seconds. Admin mutations invalidate the cache
# immediately; this only affects out-of-band changes to the ACL collection.
QDRANT_MCP_RBAC_ACL_CACHE_TTL=60

# TTL for the service token the server mints for its own ACL reads.
QDRANT_MCP_RBAC_SERVICE_TOKEN_TTL=300

# ── MCP server — Listener ─────────────────────────────────────────────────
QDRANT_MCP_PORT=8000
QDRANT_MCP_PATH=/mcp
QDRANT_MCP_LOG_LEVEL=INFO

# ── Images (pin specific versions for reproducible deployments) ───────────
# QDRANT_MCP_IMAGE=ghcr.io/fidonis/qdrant-mcp-rbac:0.3.0
