# ═══════════════════════════════════════════════════════════════════════════
# papaia-addon-qdrant-ingest — environment variables
# by Fidonis GmbH · https://fidonis.de
#
# Seeded by `papaia-ctl addon install qdrant-ingest` into the config bundle
# at <papaia-config>/addons/qdrant-ingest/.env. Copied into this directory by
# `papaia-ctl addon start qdrant-ingest` before docker compose up.
# GENERATE_* values are auto-generated as random secrets on first install.
# CHANGE_ME values must be set manually before starting the addon.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core OIDC ────────────────────────────────────────────────────────────
# Keycloak issuer URL — browser-facing URL, used to validate the Bearer
# tokens LibreChat forwards to the MCP endpoint. Must match AUTH_HOST /
# OIDC_ISSUER from the core setup. Leave empty to disable MCP entirely; the
# REST control plane is unaffected either way.
OIDC_ISSUER=CHANGE_ME

# papAIa config directory — used to mount the local CA cert and this addon's
# own bundle directory, which is where jobs.yaml and connections.yaml live.
# Auto-filled from the core config on 'papaia-ctl addon install qdrant-ingest'.
PAPAIA_CONFIG_DIR=CHANGE_ME

# ── Connections ──────────────────────────────────────────────────────────
# The Qdrant instances jobs write to are declared as named connections in
# <papaia-config>/addons/qdrant-ingest/catalog/connections.yaml, managed from
# the web interface. Their api-keys are stored encrypted; this is the key the
# encryption is derived from. Auto-generated on install. Rotating it
# invalidates every stored key — re-enter them from the interface. Connections
# without an api-key (an unauthenticated Qdrant) work without this set.
QI_CONNECTIONS_SECRET=GENERATE_SECRET

# ── Embeddings ────────────────────────────────────────────────────────────
# OpenAI-compatible embeddings endpoint. The base URL must already include
# the API prefix. Inside papaia, LiteLLM is reachable at
# http://litellm:4000/v1 through the generated Seam-1 network override. The
# model is set per job in jobs.yaml (defaults.embedding.model, or a job
# override), not here.
QI_EMBEDDING_API_URL=http://litellm:4000/v1

# API key for the embeddings endpoint. For LiteLLM this is
# LITELLM_MASTER_KEY from <papaia-config>/ai/litellm/.env.
QI_EMBEDDING_API_KEY=CHANGE_ME

# System collections of the MCP layer. Jobs may not target them, and the
# ingester writes the per-collection embedding metadata into the first one.
QI_EMBED_META_COLLECTION=_collection_meta
QI_RBAC_ACL_COLLECTION=_rbac_acl

# Chunks per embedding request, retries before a run fails, and the two
# throttles. QI_EMBED_CONCURRENCY is a global ceiling across all jobs — the
# embeddings endpoint is one shared bottleneck no matter how many jobs run.
# QI_EMBED_RPS is a token-bucket rate limit for metered cloud models; 0 = off.
QI_EMBED_BATCH_SIZE=32
QI_EMBED_RETRIES=3
QI_EMBED_CONCURRENCY=2
QI_EMBED_RPS=0

# ── Job catalog ───────────────────────────────────────────────────────────
# The job catalog and the connection list inside the container. They live in
# the catalog/ subdirectory of this addon's bundle directory
# (<papaia-config>/addons/qdrant-ingest), the one part mounted read-write.
# Nothing copies the files there — see the README's jobs.yaml section.
QI_JOBS_FILE=/config/catalog/jobs.yaml
QI_CONNECTIONS_FILE=/config/catalog/connections.yaml

# Poll interval in seconds for changes to either file; 0 disables polling. A
# reload is transactional: on a validation error the previous version keeps
# serving and the errors show up under GET /v1/config.
QI_JOBS_RELOAD_INTERVAL=30

# ── Text extraction ───────────────────────────────────────────────────────
QI_TIKA_URL=http://qdrant-ingest-tika:9998
QI_TIKA_TIMEOUT=300

# JVM heap of the Tika sidecar. Raise it when switching to the -full image.
QI_TIKA_HEAP=2g

# OCR settings. They only take effect with the -full Tika image; the default
# image cannot OCR and silently skips image-only pages.
QI_TIKA_OCR_LANGUAGE=deu+eng
QI_TIKA_PDF_OCR_STRATEGY=auto

# Send files with unknown extensions to Tika and route by the detected
# content type instead of skipping them.
QI_TIKA_SNIFF_UNKNOWN=false

# Scanned-PDF heuristic: fewer extracted characters per page than this marks
# the document skipped_no_text rather than indexing an empty document.
QI_MIN_CHARS_PER_PAGE=100

# Larger files are never sent to Tika and are recorded skipped_too_large.
QI_MAX_FILE_BYTES=209715200

# Data rows per spreadsheet chunk; each chunk repeats the header row.
QI_SHEET_ROWS=40

# ── Scheduling ────────────────────────────────────────────────────────────
# Scheduler worker threads. Independent of QI_EMBED_CONCURRENCY: several jobs
# may sync and extract at once while fewer of them embed.
QI_MAX_CONCURRENT_JOBS=2

# IANA timezone name for cron expressions, for example Europe/Berlin.
QI_TIMEZONE=UTC

# How late a missed cron fire may still run, and the random spread applied to
# each fire so several jobs do not start in the same second.
QI_MISFIRE_GRACE=300
QI_CRON_JITTER=30

# Seconds a run waits for the per-collection lock before giving up with
# aborted_lock. A full reindex takes that lock exclusively.
QI_LOCK_TIMEOUT=60

# Runs kept per job; older ones are pruned with their events after each run.
QI_RUN_HISTORY_LIMIT=200

# Seconds granted to running jobs to stop between documents on shutdown.
QI_SHUTDOWN_GRACE=30

# ── Control plane — REST ──────────────────────────────────────────────────
# Authentication scheme for /v1. Only 'token' is implemented; the axis exists
# so an OIDC service account can be added later without an env rename.
QI_REST_AUTH=token

# Bearer token required on every /v1 call. Auto-generated on install — you
# never enter it by hand. Read it from
# <papaia-config>/addons/qdrant-ingest/.env when calling the API.
QI_API_TOKEN=GENERATE_SECRET

QI_HTTP_HOST=0.0.0.0
QI_HTTP_PORT=8300

# Prometheus metrics. QI_METRICS_AUTH=false exposes /metrics without the
# bearer token to scrapers on this network.
QI_METRICS_ENABLED=true
QI_METRICS_AUTH=true

QI_LOG_LEVEL=INFO

# ── Control plane — MCP over OIDC ─────────────────────────────────────────
QI_MCP_PATH=/mcp

# Token audience expected in incoming Bearer tokens from LibreChat.
# REQUIRED, not cosmetic: this value only takes effect if a matching
# 'mcp-qdrant-ingest-audience' mapper exists on the LibreChat Keycloak
# client. Without that mapper every MCP call fails with 401 — see README
# step 2. mcp-qdrant-ingest needs no client secret: it is a Bearer-token
# resource server that verifies tokens against Keycloak's public JWKS and
# never authenticates itself to Keycloak.
QI_OIDC_AUDIENCE=mcp-qdrant-ingest

# Keycloak realm role required on every MCP call. Realm roles are outside the
# addon integration contract, so this one is always created manually — see
# integration/infra/keycloak/qdrant-ingest-operator-role.json.
QI_OIDC_OPERATOR_ROLE=qdrant-ingest-operator

QI_OIDC_JWKS_CACHE_TTL=3600

# ── Web interface ─────────────────────────────────────────────────────────
# Optional operator web UI at QI_UI_PUBLIC_URL + QI_UI_PATH (default /ui),
# served by the same process as REST and MCP. It stays unmounted unless
# OIDC_ISSUER above and all three values below are non-empty -- leave
# QI_UI_PUBLIC_URL blank (not CHANGE_ME) to keep it off deliberately.
# See the README's "Web interface" section.
#
# Browser-facing URL of this addon, e.g. https://ingest.example.com. The
# redirect URI Keycloak must accept is <this>/ui/auth/callback.
QI_UI_PUBLIC_URL=CHANGE_ME

# Client ID of the confidential Keycloak client created for the interface
# (see integration/infra/keycloak/qdrant-ingest-ui.json). Fixed default;
# change only if you renamed the client on import.
QI_UI_CLIENT_ID=qdrant-ingest-ui

# Filled in after importing qdrant-ingest-ui.json — see the README's
# Keycloak checklist. The interface reuses QI_OIDC_OPERATOR_ROLE; no second
# realm role is needed.
QI_UI_CLIENT_SECRET=REPLACE_WITH_QI_UI_CLIENT_SECRET

# Signs the session cookie. Auto-generated on install; rotating it signs
# every operator out.
QI_UI_SESSION_SECRET=GENERATE_SECRET

# Optional overrides — sane defaults, uncomment to change.
# QI_UI_ENABLED=true
# QI_UI_PATH=/ui
# QI_UI_SESSION_TTL=28800

# ── Source credentials ────────────────────────────────────────────────────
# Credential values never appear in jobs.yaml. Every secret-typed field there
# accepts only the form ${env:QI_SECRET_<NAME>} and resolves against these
# variables; a literal in such a field is a hard validation error. That makes
# the job catalog commit-safe by construction rather than by convention.
#
# These three slots exist so the common cases need no extra keys. Leave them
# empty when all sources are local — an empty value is not prompted for and
# not warned about.
QI_SECRET_1=
QI_SECRET_2=
QI_SECRET_3=

# Any number of further QI_SECRET_<NAME> keys may simply be appended to the
# bundle .env at <papaia-config>/addons/qdrant-ingest/.env, for example:
#
#   QI_SECRET_S3_ACCESS_KEY=...
#   QI_SECRET_NEXTCLOUD_APP_PASSWORD=...
#
# and referenced from jobs.yaml as ${env:QI_SECRET_S3_ACCESS_KEY}. This is
# safe across reinstalls: the seeding step only adds keys that are listed
# here and missing from the bundle, and never removes or overwrites keys an
# operator added. Only names matching ^QI_SECRET_[A-Z0-9_]+$ are resolvable,
# so a tampered jobs.yaml cannot read QI_CONNECTIONS_SECRET or QI_API_TOKEN.

# ── Local documents ───────────────────────────────────────────────────────
# Host directory mounted read-only at /data/local for sources of type
# 'local'. Defaults to this addon's bundle directory, which always exists, so
# a fresh install never fails on the mount. Point it at the real document
# directory and address paths below /data/local from jobs.yaml.
# QI_LOCAL_MOUNT=/srv/documents

# ── Published control-plane port ──────────────────────────────────────────
# Not published by default. Uncomment the ports: block in docker-compose.yml
# as well to expose the REST API and set this; keep it on a trusted interface
# via HOST_IP in the core .env.
# QI_EXT_PORT=8300

# ── Images (pin specific versions for reproducible deployments) ───────────
# QI_INGEST_IMAGE=ghcr.io/fidonis/qdrant-ingest:0.1.1
# The -full variant adds Tesseract and can OCR scanned PDFs and images. It is
# roughly 400 MB larger and wants QI_TIKA_HEAP raised accordingly.
# QI_TIKA_IMAGE=docker.io/apache/tika:3.2.3.0-full
